# Copy to .env and fill in. Only the ICU_* values are secret.

# intervals.icu (Settings -> Developer for the API key; athlete id is the "i123..." or number)
ICU_API_KEY=
ICU_ATHLETE_ID=

# Where the skill is installed (shared engine scripts + data caches + map template).
# Default is the standard Claude skills location; override if yours differs.
# SKILL_DIR=C:\Users\you\.claude\skills\gpx-workout-designer-v2

# Server (defaults are fine)
# HOST=127.0.0.1
# PORT=8712

# Design reference speed (min<->km mapping for distance-based steps)
# REF_SPEED_KMH=30
# BUFFER_KM=5
